menu "Pocket Passport"
config PASSPORT_MUSE_BLE
    bool "Enable experimental official Muse BLE pairing"
    depends on BT_ENABLED && BT_NIMBLE_ENABLED && BT_NIMBLE_NVS_PERSIST && BT_NIMBLE_SM_SC
    default n
    help
        Start the Muse pairing/Android companion BLE services when opening Muse.
        Requires device acceptance of RAM coexistence with Wi-Fi and audio.
        Chat and voice integration are not complete yet.
config MUSE_PHONE_BRIDGE
    bool
    default y if PASSPORT_MUSE_BLE
endmenu
