# Experimental single-connection ESP32-C3 Muse profile; no credentials.
# Normal sdkconfig.defaults keeps Muse disabled. Use a fresh SDKCONFIG when
# applying this file after sdkconfig.defaults; verify on the actual device.
# Experimental optional Muse profile, appended after sdkconfig.defaults.
# Not enabled in release defaults. Physical Bluetooth startup still requires
# a verified internal-RAM budget; successful compilation is not acceptance.
CONFIG_BT_ENABLED=y
CONFIG_BSP_LVGL_DRAW_BUFFER_LINES=16
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_NVS_PERSIST=y
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=247
CONFIG_PASSPORT_MUSE_BLE=y
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_COUNT=4
CONFIG_BT_NIMBLE_MSYS_2_BLOCK_COUNT=4
CONFIG_BT_NIMBLE_TRANSPORT_ACL_FROM_LL_COUNT=4
CONFIG_BT_NIMBLE_TRANSPORT_EVT_COUNT=8
CONFIG_BT_NIMBLE_TRANSPORT_EVT_DISCARD_COUNT=2
CONFIG_BT_CTRL_BLE_MAX_ACT=2
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=4
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=12
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=12
CONFIG_ESP_WIFI_RX_BA_WIN=4
